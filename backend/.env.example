DJANGO_SECRET_KEY=dev-only-insecure-key-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*

POSTGRES_DB=callout
POSTGRES_USER=callout
POSTGRES_PASSWORD=callout
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0

CORS_ALLOW_ALL_ORIGINS=true
STATUS_CACHE_TTL_SECONDS=4
RECIPIENT_BATCH_SIZE=1000

# Optional. Leave blank to run the AI feature in its fallback path, the
# draft endpoint returns available: false and the screen asks for a
# manually written draft instead.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_PROVIDER_TIMEOUT_SECONDS=8
